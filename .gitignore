# ═══════════════════════════════════════════════
#   ChainGuard — .gitignore
# ═══════════════════════════════════════════════

# ── SECRETS (CRITICAL — never commit these) ─────
.env
.env.local
.env.production
.env.staging
*.key
secrets/

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
site-packages/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# ── IDEs ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── CrewAI / LangChain cache ─────────────────────
.langchain/
langchain_cache/
crewai_cache/

# ── Misc ────────────────────────────────────────
*.tmp
*.bak
node_modules/